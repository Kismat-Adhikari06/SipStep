<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_water_background"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:letterSpacing="0.06"
                android:text="TODAY'S WATER"
                android:textColor="#11777B"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:maxLines="1"
                android:text="Loading…"
                android:textColor="#182533"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#536A76"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="1dp"
                android:text="Updating today’s water…"
                android:textColor="#536A76"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#DCEEEF"
                android:progressTint="#18AEB2" />

            <TextView
                android:id="@+id/widget_add_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/widget_water_add_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="96dp"
                android:paddingHorizontal="10dp"
                android:text="+250 ml"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="56dp"
            android:layout_height="78dp"
            android:adjustViewBounds="true"
            android:contentDescription="Wello shows your water progress"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mascot_wave" />
    </LinearLayout>
</FrameLayout>
